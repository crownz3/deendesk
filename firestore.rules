rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. Auth & Basic Helpers
    // ==========================================
    function signedIn() {
      return request.auth != null;
    }

    function superEmail() {
      return signedIn() && request.auth.token.email == 'mohamedibrahim010425@gmail.com';
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentRole() {
      return currentUser().get('role', null);
    }

    function isActive() {
      return superEmail() || (userExists() && currentUser().get('status', null) == 'active');
    }

    function hasPermission(permission) {
      let perms = currentUser().get('permissions', []);
      return isSuper() || (isActive() && perms is list && permission in perms);
    }

    // ==========================================
    // 2. Role Helpers
    // ==========================================
    function isSuper() {
      return superEmail() || (isActive() && currentRole() in ['superAdmin', 'SUPER_ADMIN']);
    }

    function isOrgAdmin() {
      return isActive() && currentRole() in ['organizationAdmin', 'ORGANIZATION_ADMIN'];
    }

    function isCoordinator() {
      return isActive() && currentRole() in ['coordinator', 'COORDINATOR'];
    }

    function isMadrasaIncharge() {
      return isActive() && currentRole() in ['madrasaIncharge', 'MADRASA_INCHARGE'];
    }

    function isTeacherOrStaff() {
      return isActive() && currentRole() in ['teacher', 'TEACHER', 'staff', 'STAFF'];
    }

    function isStudent() {
      return isActive() && currentRole() in ['student', 'STUDENT'];
    }

    function isParent() {
      return isActive() && currentRole() in ['parent', 'PARENT'];
    }

    // ==========================================
    // 3. Role Group Helpers
    // ==========================================
    function isLowerThanOrgAdmin(role) {
      return role in [
        'coordinator', 'madrasaIncharge', 'stageHead', 'teacher', 'staff', 'student', 'parent',
        'COORDINATOR', 'MADRASA_INCHARGE', 'STAGE_HEAD', 'TEACHER', 'STAFF', 'STUDENT', 'PARENT'
      ];
    }

    function isCoordinatorManagedRole(role) {
      return role in [
        'madrasaIncharge', 'stageHead', 'teacher', 'staff', 'student', 'parent',
        'MADRASA_INCHARGE', 'STAGE_HEAD', 'TEACHER', 'STAFF', 'STUDENT', 'PARENT'
      ];
    }

    function isMadrasaInchargeManagedRole(role) {
      return role in [
        'stageHead', 'teacher', 'staff', 'student', 'parent',
        'STAGE_HEAD', 'TEACHER', 'STAFF', 'STUDENT', 'PARENT'
      ];
    }

    function isStudentRole(role) {
      return role in ['student', 'STUDENT'];
    }

    function isStaffOrTeacherRole(role) {
      return role in ['teacher', 'staff', 'stageHead', 'TEACHER', 'STAFF', 'STAGE_HEAD'];
    }

    function isParentRole(role) {
      return role in ['parent', 'PARENT'];
    }

    function hasRolePermission(role) {
      return true;
    }

    // ==========================================
    // 4. Scope Helpers
    // ==========================================
    function sameOrg(data) {
      return isActive()
        && currentUser().get('organizationId', null) != null
        && (
          data.get('organizationId', null) == null
          || data.get('organizationId', null) == currentUser().get('organizationId', null)
        );
    }

    function ownOrgId(orgId) {
      return isActive() && currentUser().get('organizationId', null) == orgId;
    }

    function currentMadrasaIds() {
      let ids = currentUser().get('madrasaIds', []);
      return ids is list ? ids : [];
    }

    function currentMadrasaId() {
      return currentUser().get('madrasaId', null);
    }

    function targetMadrasaId(data) {
      return data.get('madrasaId', null);
    }

    function targetMadrasaIds(data) {
      let ids = data.get('madrasaIds', []);
      return ids is list ? ids : [];
    }

    function isAssignedMadrasaId(id) {
      return id in currentMadrasaIds() || (currentMadrasaId() != null && currentMadrasaId() == id);
    }

    function assignedMadrasa(data) {
      return isActive()
        && targetMadrasaId(data) != null
        && (
          targetMadrasaId(data) in currentMadrasaIds()
          || (currentMadrasaId() != null && currentMadrasaId() == targetMadrasaId(data))
        );
    }

    function assignedMadrasaArray(data) {
      return isActive()
        && targetMadrasaIds(data).size() > 0
        && (
          targetMadrasaIds(data).hasAny(currentMadrasaIds())
          || (currentMadrasaId() != null && currentMadrasaId() in targetMadrasaIds(data))
        );
    }

    function assignedOldMadrasa(data) {
      return isActive()
        && data.get('oldMadrasaId', null) != null
        && (
          data.get('oldMadrasaId', null) in currentMadrasaIds()
          || (currentMadrasaId() != null && currentMadrasaId() == data.get('oldMadrasaId', null))
        );
    }

    function inAssignedMadrasaScope(data) {
      return sameOrg(data) && (assignedMadrasa(data) || assignedMadrasaArray(data));
    }

    function isGlobalOrgAcademicData(data) {
      return sameOrg(data) && (data.get('madrasaId', null) == null || data.get('madrasaId', null) == '');
    }

    function currentEntityId() {
      return signedIn() ? currentUser().get('entityId', null) : null;
    }

    function isEventResponsibleStaff(data) {
      let eId = currentEntityId();
      let additional = data.get('additionalResponsibleStaffIds', []);
      let safeAdditional = additional is list ? additional : [];
      return isActive() && eId != null && (
        data.get('staffInChargeId', null) == eId
        || (safeAdditional.size() > 0 && eId in safeAdditional)
      );
    }

    function assignedClass(data) {
      let currentClasses = currentUser().get('classIds', []);
      let safeCurrentClasses = currentClasses is list ? currentClasses : [];
      let targetClasses = data.get('classIds', []);
      let safeTargetClasses = targetClasses is list ? targetClasses : [];
      
      return isActive()
        && (
          data.get('classId', null) in safeCurrentClasses
          || (safeTargetClasses.size() > 0 && safeTargetClasses.hasAny(safeCurrentClasses))
        );
    }

    function assignedSubject(data) {
      let currentSubjects = currentUser().get('subjectIds', []);
      let safeCurrentSubjects = currentSubjects is list ? currentSubjects : [];
      let targetSubjects = data.get('subjectIds', []);
      let safeTargetSubjects = targetSubjects is list ? targetSubjects : [];

      return isActive()
        && (
          data.get('subjectId', null) in safeCurrentSubjects
          || (safeTargetSubjects.size() > 0 && safeTargetSubjects.hasAny(safeCurrentSubjects))
        );
    }

    function isAssignedTeacher(data) {
      return isActive()
        && (
          ('teacherUids' in data && request.auth.uid in data.teacherUids)
          || ('teacherIds' in data && request.auth.uid in data.teacherIds) // fallback for backwards compat / manual edits
          || ('linkedStudentUserIds' in data && request.auth.uid in data.linkedStudentUserIds)
          || ('studentIds' in data && request.auth.uid in data.studentIds)
        );
    }

    function ownUserDoc(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    function ownUserData(data) {
      return signedIn()
        && (
          data.get('uid', null) == request.auth.uid
          || data.get('userId', null) == request.auth.uid
        );
    }

    function linkedStudent(data) {
      return isParent()
        && (
          data.get('uid', null) in currentUser().get('linkedStudentIds', [])
          || data.get('userId', null) in currentUser().get('linkedStudentIds', [])
          || data.get('studentId', null) in currentUser().get('linkedStudentIds', [])
        );
    }

    // ==========================================
    // 5. User Roles (Read / Create / Update / Delete)
    // ==========================================
    function canReadUserByScope(data) {
      let role = data.get('role', null);

      return isSuper()
        || ownUserData(data)
        || (isOrgAdmin() && sameOrg(data) && !(role in ['superAdmin', 'SUPER_ADMIN']))
        || (
          (isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff())
          && sameOrg(data)
        )
        || linkedStudent(data);
    }

    function canCreateUser(data, uid) {
      let role = data.get('role', null);

      return isSuper()
        || (
          superEmail() && uid == request.auth.uid
        )
        || (
          uid == request.auth.uid
          && role in ['student', 'STUDENT']
          && data.get('status', null) == 'pending'
        )
        || (
          isOrgAdmin()
          && sameOrg(data)
          && isLowerThanOrgAdmin(role)
        )
        || (
          isCoordinator()
          && inAssignedMadrasaScope(data)
          && isCoordinatorManagedRole(role)
        )
        || (
          isMadrasaIncharge()
          && inAssignedMadrasaScope(data)
          && isMadrasaInchargeManagedRole(role)
        )
        || (
          isTeacherOrStaff()
          && sameOrg(data)
          && isStudentRole(role)
        );
    }

    function unchangedIdentityFields(oldData, newData) {
      return oldData.get('role', null) == newData.get('role', null)
        && oldData.get('organizationId', null) == newData.get('organizationId', null)
        && oldData.get('uid', null) == newData.get('uid', null)
        && oldData.get('userId', null) == newData.get('userId', null);
    }

    function unchangedCoreFields(oldData, newData) {
      return oldData.get('organizationId', null) == newData.get('organizationId', null)
        && oldData.get('createdBy', null) == newData.get('createdBy', null)
        && oldData.get('createdAt', null) == newData.get('createdAt', null)
        && oldData.get('userId', null) == newData.get('userId', null)
        && oldData.get('eventId', null) == newData.get('eventId', null)
        && oldData.get('issueId', null) == newData.get('issueId', null)
        && oldData.get('assetId', null) == newData.get('assetId', null);
    }

    function selfProfileUpdateFieldsOnly(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
        'displayName',
        'name',
        'phone',
        'phoneNumber',
        'mobileNumber',
        'photoURL',
        'updatedAt',
        'updatedBy',
        'lastLoginAt',
        'email'
      ]);
    }

    function selfPasswordCompletionFieldsOnly(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
        'mustChangePassword',
        'temporaryPasswordForAdminView',
        'passwordChangedAt',
        'updatedAt',
        'updatedBy',
        'lastLoginAt'
      ]);
    }

    function identityUnchangedForSelf(oldData, newData) {
      return oldData.get('role', null) == newData.get('role', null)
        && oldData.get('organizationId', null) == newData.get('organizationId', null)
        && oldData.get('madrasaId', null) == newData.get('madrasaId', null)
        && oldData.get('madrasaIds', []) == newData.get('madrasaIds', [])
        && oldData.get('permissions', []) == newData.get('permissions', [])
        && oldData.get('status', null) == newData.get('status', null)
        && oldData.get('email', null) == newData.get('email', null)
        && oldData.get('uid', null) == newData.get('uid', null)
        && oldData.get('userId', null) == newData.get('userId', null);
    }

    function canCompleteOwnPasswordChange(oldData, newData) {
      return signedIn()
        && (oldData.get('uid', null) == request.auth.uid || oldData.get('userId', null) == request.auth.uid)
        && identityUnchangedForSelf(oldData, newData)
        && selfPasswordCompletionFieldsOnly(oldData, newData)
        && oldData.get('mustChangePassword', false) == true
        && newData.get('mustChangePassword', false) == false;
    }

    function studentAssignmentFieldsOnly(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
        'courseId',
        'courseName',
        'courseIds',
        'classId',
        'className',
        'classIds',
        'groupId',
        'groupIds',
        'assignedCourseId',
        'assignedCourseIds',
        'assignedClassId',
        'assignedClassIds',
        'updatedAt',
        'updatedBy'
      ]);
    }

    function staffAssignmentFieldsOnly(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
        'teachingCourseIds',
        'teachingClassIds',
        'teachingSubjectIds',
        'courseId',
        'courseIds',
        'classId',
        'classIds',
        'groupId',
        'groupIds',
        'subjectId',
        'subjectIds',
        'assignedCourseId',
        'assignedCourseIds',
        'assignedClassId',
        'assignedClassIds',
        'assignedSubjectId',
        'assignedSubjectIds',
        'assignedStages',
        'assignedCourseStages',
        'genderScope',
        'madrasaId',
        'madrasaIds',
        'role',
        'updatedAt',
        'updatedBy'
      ]);
    }

    function roleAdminUpdateFieldsSafe(oldData, newData) {
      return oldData.get('organizationId', null) == newData.get('organizationId', null)
        && oldData.get('uid', null) == newData.get('uid', null)
        && oldData.get('userId', null) == newData.get('userId', null);
    }

    function canAssignStudent(oldData, newData) {
      let role = oldData.get('role', null);

      return isStudentRole(role)
        && unchangedIdentityFields(oldData, newData)
        && studentAssignmentFieldsOnly(oldData, newData)
        && (
          (isSuper())
          || (isOrgAdmin() && sameOrg(oldData))
          || (isCoordinator() && inAssignedMadrasaScope(oldData))
          || (isMadrasaIncharge() && inAssignedMadrasaScope(oldData))
          || (isTeacherOrStaff() && sameOrg(oldData))
        );
    }

    function canAssignStaff(oldData, newData) {
      let role = oldData.get('role', null);

      return isStaffOrTeacherRole(role)
        && (unchangedIdentityFields(oldData, newData) || (oldRoleInStaffScope(oldData) && newRoleInStaffScope(newData)))
        && staffAssignmentFieldsOnly(oldData, newData)
        && (
          (isSuper())
          || (isOrgAdmin() && sameOrg(oldData))
          || (isCoordinator() && inAssignedMadrasaScope(oldData))
          || (isMadrasaIncharge() && inAssignedMadrasaScope(oldData))
        );
    }

    function oldRoleInStaffScope(data) {
      let r = data.get('role', null);
      return r in ['teacher', 'staff', 'stageHead', 'TEACHER', 'STAFF', 'STAGE_HEAD'];
    }

    function newRoleInStaffScope(data) {
      let r = data.get('role', null);
      return r in ['teacher', 'staff', 'stageHead', 'TEACHER', 'STAFF', 'STAGE_HEAD'];
    }

    function canAdminUpdateUser(oldData, newData) {
      let oldRole = oldData.get('role', null);
      let newRole = newData.get('role', null);

      return (oldRole == newRole || (oldRoleInStaffScope(oldData) && newRoleInStaffScope(newData)))
        && oldData.get('organizationId', null) == newData.get('organizationId', null)
        && (
          (isOrgAdmin() && sameOrg(oldData) && isLowerThanOrgAdmin(oldRole) && isLowerThanOrgAdmin(newRole))
          || (isCoordinator() && inAssignedMadrasaScope(oldData) && isCoordinatorManagedRole(oldRole) && isCoordinatorManagedRole(newRole))
          || (isMadrasaIncharge() && inAssignedMadrasaScope(oldData) && isMadrasaInchargeManagedRole(oldRole) && isMadrasaInchargeManagedRole(newRole))
          || (isTeacherOrStaff() && sameOrg(oldData) && isStudentRole(oldRole))
        );
    }

    function canUpdateUserByScope(oldData, newData) {
      return isSuper()
        || (
          ownUserData(oldData)
          && unchangedIdentityFields(oldData, newData)
          && selfProfileUpdateFieldsOnly(oldData, newData)
        )
        || canCompleteOwnPasswordChange(oldData, newData)
        || canAssignStudent(oldData, newData)
        || canAssignStaff(oldData, newData)
        || canAdminUpdateUser(oldData, newData);
    }

    function canDeleteUserByScope(data) {
      let role = data.get('role', null);

      return isSuper()
        || (
          isOrgAdmin()
          && sameOrg(data)
          && isLowerThanOrgAdmin(role)
        )
        || (
          isCoordinator()
          && inAssignedMadrasaScope(data)
          && isCoordinatorManagedRole(role)
        )
        || (
          isMadrasaIncharge()
          && inAssignedMadrasaScope(data)
          && isMadrasaInchargeManagedRole(role)
        )
        || (
          isTeacherOrStaff()
          && sameOrg(data)
          && isStudentRole(role)
        );
    }

    // ==========================================
    // 6. Module & Collection Helpers
    // ==========================================
    function canReadScopedModule(data, permission) {
      return isSuper()
        || (
          sameOrg(data)
          && (
            isOrgAdmin()
            || isCoordinator()
            || isMadrasaIncharge()
            || isTeacherOrStaff()
            || isStudent()
            || isParent()
          )
        );
    }

    function canReadAssignedData(data) {
      return isSuper()
        || (isOrgAdmin() && sameOrg(data))
        || (isCoordinator() && sameOrg(data) && (inAssignedMadrasaScope(data) || isGlobalOrgAcademicData(data)))
        || (isMadrasaIncharge() && sameOrg(data) && (inAssignedMadrasaScope(data) || isGlobalOrgAcademicData(data)))
        || (isTeacherOrStaff() && sameOrg(data) && isAssignedTeacher(data))
        || (isStudent() && sameOrg(data))
        || (isParent() && sameOrg(data));
    }

    function canWriteScopedModule(data, permission) {
      return isSuper()
        || (isOrgAdmin() && sameOrg(data))
        || (isCoordinator() && inAssignedMadrasaScope(data))
        || (isMadrasaIncharge() && inAssignedMadrasaScope(data))
        || (isTeacherOrStaff() && sameOrg(data));
    }

    function canReadClassPlan(data) {
      return isSuper()
        || (
          sameOrg(data)
          && (
            isOrgAdmin()
            || isCoordinator()
            || isMadrasaIncharge()
            || isTeacherOrStaff()
            || isStudent()
            || isParent()
          )
        );
    }

    function canWriteClassPlan(data) {
      return isSuper()
        || (isOrgAdmin() && sameOrg(data))
        || (isCoordinator() && inAssignedMadrasaScope(data))
        || (isMadrasaIncharge() && inAssignedMadrasaScope(data))
        || (isTeacherOrStaff() && sameOrg(data));
    }

    // ==========================================
    // 7. Users Collection Rules
    // ==========================================
    match /users/{uid} {
      allow get: if signedIn() && (ownUserDoc(uid) || canReadUserByScope(resource.data));
      allow list: if signedIn() && canReadUserByScope(resource.data);
      allow create: if signedIn() && canCreateUser(request.resource.data, uid);
      allow update: if signedIn() && canUpdateUserByScope(resource.data, request.resource.data);
      allow delete: if signedIn() && request.auth.uid != uid && canDeleteUserByScope(resource.data);
    }

    // ==========================================
    // 8. Collection Rules
    // ==========================================
    match /organizations/{orgId} {
      allow read: if isSuper() || ownOrgId(orgId);
      allow create: if isSuper();
      allow update: if isSuper() || ownOrgId(orgId);
      allow delete: if isSuper();
    }

    match /madrasas/{id} {
      allow read: if isSuper() 
                  || (sameOrg(resource.data) && (isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff() || isStudent() || isParent()));
      allow create: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin());
      allow update: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || ((isCoordinator() || isMadrasaIncharge()) && isAssignedMadrasaId(id)));
      allow delete: if sameOrg(resource.data) && (isSuper() || isOrgAdmin());
    }

    match /courses/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageCourses') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'manageCourses');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageCourses');
    }

    match /classes/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageClasses') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'manageClasses');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageClasses');
    }

    match /classGroups/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageClasses') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'manageClasses');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageClasses');
    }

    match /subjects/{id} {
      allow read: if canReadAssignedData(resource.data);
      allow create: if canWriteScopedModule(request.resource.data, 'manageSubjects');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageSubjects');
    }

    match /academicPlans/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageAcademicPlans') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'manageAcademicPlans');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageAcademicPlans');
    }

    match /classPlans/{id} {
      allow read: if canReadClassPlan(resource.data);
      allow create: if canWriteClassPlan(request.resource.data);
      allow update, delete: if canWriteClassPlan(resource.data);
    }

    match /classPlanExceptions/{id} {
      allow read: if canReadClassPlan(resource.data);
      allow create: if canWriteClassPlan(request.resource.data);
      allow update, delete: if canWriteClassPlan(resource.data);
    }

    match /timetableEntries/{id} {
      allow read: if canReadClassPlan(resource.data);
      allow create: if canWriteClassPlan(request.resource.data);
      allow update, delete: if canWriteClassPlan(resource.data);
    }

    match /staff/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageStaff') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'manageStaff');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageStaff');
    }

    match /students/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageStudents') || canReadScopedModule(resource.data, 'viewDashboard') || (isActive() && id in currentUser().get('linkedStudentIds', []));
      allow create: if canWriteScopedModule(request.resource.data, 'manageStudents');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageStudents');
    }

    match /parents/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageParents') || canReadScopedModule(resource.data, 'viewDashboard') || ownUserData(resource.data);
      allow create: if canWriteScopedModule(request.resource.data, 'manageParents');
      allow update, delete: if canWriteScopedModule(resource.data, 'manageParents');
    }

    match /attendance/{id} {
      allow read: if canReadScopedModule(resource.data, 'viewAttendance') || canReadScopedModule(resource.data, 'viewDashboard');
      allow create: if canWriteScopedModule(request.resource.data, 'takeAttendance');
      allow update, delete: if canWriteScopedModule(resource.data, 'takeAttendance');
    }

    match /promotionHistory/{id} {
      allow read: if canReadScopedModule(resource.data, 'generateReports');
      allow create: if canWriteScopedModule(request.resource.data, 'managePromotions');
      allow update, delete: if canWriteScopedModule(resource.data, 'managePromotions');
    }

    match /studentTransfers/{id} {
      allow read: if canReadScopedModule(resource.data, 'manageStudents') || canReadScopedModule(resource.data, 'generateReports');
      allow create: if canWriteScopedModule(request.resource.data, 'manageStudents') || (
        isActive() 
        && sameOrg(request.resource.data) 
        && assignedOldMadrasa(request.resource.data)
        && (isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff())
      );
      allow update, delete: if canWriteScopedModule(resource.data, 'manageStudents');
    }

    match /reports/{id} {
      allow read: if canReadScopedModule(resource.data, 'generateReports');
      allow create: if canWriteScopedModule(request.resource.data, 'generateReports');
      allow update, delete: if isSuper() || canWriteScopedModule(resource.data, 'generateReports');
    }

    match /notifications/{id} {
      allow read: if isSuper()
        || (isActive() && request.auth.uid in resource.data.get('recipientUserIds', []))
        || canReadScopedModule(resource.data, 'manageNotifications');
      allow create: if canWriteScopedModule(request.resource.data, 'manageNotifications');
      allow update: if isSuper()
        || (isActive() && request.auth.uid in resource.data.get('recipientUserIds', []) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt', 'updatedBy']))
        || canWriteScopedModule(request.resource.data, 'manageNotifications');
      allow delete: if isSuper() || canWriteScopedModule(resource.data, 'manageNotifications');
    }

    match /csvImports/{id} {
      allow read: if canReadScopedModule(resource.data, 'importCsv');
      allow create: if canWriteScopedModule(request.resource.data, 'importCsv');
      allow update, delete: if isSuper();
    }

    match /permissionTemplates/{role} {
      allow read: if isActive();
      allow write: if isSuper() || isOrgAdmin();
    }

    match /defaultCourses/{id} {
      allow read: if isActive();
      allow write: if isSuper() || isOrgAdmin();
    }

    match /accessRequests/{uid} {
      allow create: if signedIn() && uid == request.auth.uid;
      allow read, update, delete: if isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge();
    }

    match /passwordResetRequests/{id} {
      allow create: if !signedIn() || signedIn();
      allow read, update: if isSuper() || (isActive() && (resource.data.get('assignedToUid', null) == request.auth.uid || resource.data.get('organizationId', null) == currentUser().get('organizationId', null)));
      allow delete: if isSuper();
    }
    // ==========================================
    // Fee Management Rules
    // ==========================================

    // Helper: Can read fee data based on role/scope
    function canReadFeeData(data) {
      return isSuper()
        || (isOrgAdmin() && sameOrg(data))
        || (isCoordinator() && sameOrg(data) && (inAssignedMadrasaScope(data) || isGlobalOrgAcademicData(data)))
        || (isMadrasaIncharge() && sameOrg(data) && (inAssignedMadrasaScope(data) || isGlobalOrgAcademicData(data)))
        || (isTeacherOrStaff() && sameOrg(data) && data.get('responsibleStaffId', null) == request.auth.uid);
    }

    // Helper: Can write fee data based on role/scope
    function canWriteFeeData(data) {
      return isSuper()
        || (isOrgAdmin() && sameOrg(data))
        || (isCoordinator() && inAssignedMadrasaScope(data))
        || (isMadrasaIncharge() && inAssignedMadrasaScope(data));
    }

    // Helper: Can record payments (staff who are responsible can also record)
    function canRecordPayment(data) {
      return canWriteFeeData(data)
        || (isTeacherOrStaff() && sameOrg(data) && data.get('collectedByStaffId', null) == request.auth.uid);
    }

    match /feePlans/{id} {
      allow read: if canReadFeeData(resource.data) || canReadScopedModule(resource.data, 'viewFees');
      allow create: if canWriteFeeData(request.resource.data);
      allow update: if canWriteFeeData(resource.data);
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /feeAssignments/{id} {
      allow read: if canReadFeeData(resource.data) || canReadScopedModule(resource.data, 'viewFees');
      allow create: if canWriteFeeData(request.resource.data);
      allow update: if canWriteFeeData(resource.data) || canRecordPayment(resource.data);
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /feePayments/{id} {
      allow read: if canReadFeeData(resource.data) || canReadScopedModule(resource.data, 'viewFees');
      allow create: if canRecordPayment(request.resource.data);
      // Payments are append-only: no update/delete to maintain history
      allow update, delete: if isSuper();
    }


    // ==========================================
    // Audit Logs Rules
    // ==========================================
    match /auditLogs/{id} {
      allow read: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
      allow create: if signedIn() && request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if false; // Append-only by design
    }

    // ==========================================
    // 9. Events, Issues, Properties & Lifecycle Rules
    // ==========================================
    match /events/{id} {
      allow read: if isSuper() || (sameOrg(resource.data) && (isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff() || isStudent() || isParent()));
      allow create: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageEvents'));
      allow update: if sameOrg(resource.data) && unchangedCoreFields(resource.data, request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageEvents') || isEventResponsibleStaff(resource.data));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /eventParticipants/{id} {
      allow read: if isSuper() || (sameOrg(resource.data) && (isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff() || isStudent() || isParent()));
      allow create: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageEvents'));
      allow update: if sameOrg(resource.data) && unchangedCoreFields(resource.data, request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageEvents'));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /eventScheduleHistory/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge());
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageEvents'));
      allow update, delete: if false;
    }

    match /eventAttendance/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create, update: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('recordEventAttendance'));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /issueCategories/{id} {
      allow read: if isActive() && sameOrg(resource.data);
      allow write: if isSuper() || (isOrgAdmin() && sameOrg(request.resource.data));
    }

    match /issues/{id} {
      allow read: if isSuper()
                  || (isOrgAdmin() && sameOrg(resource.data))
                  || (isCoordinator() && inAssignedMadrasaScope(resource.data))
                  || (isMadrasaIncharge() && inAssignedMadrasaScope(resource.data))
                  || (isTeacherOrStaff() && sameOrg(resource.data) && (resource.data.reportedBy == request.auth.uid || resource.data.assignedStaffId == request.auth.uid))
                  || (ownUserData(resource.data) && resource.data.confidential == false);
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('reportIssues'));
      allow update: if sameOrg(resource.data) && unchangedCoreFields(resource.data, request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || (isTeacherOrStaff() && resource.data.assignedStaffId == request.auth.uid));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /issuePrivateDetails/{id} {
      allow read, write: if isSuper() || (sameOrg(resource.data) && (isOrgAdmin() || isCoordinator() || isMadrasaIncharge()) && (hasPermission('viewConfidentialIssues') || hasPermission('manageIssues')));
    }

    match /issueInternalNotes/{id} {
      allow read, write: if isSuper() || (sameOrg(resource.data) && (isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || (isTeacherOrStaff() && hasPermission('viewConfidentialIssues'))));
    }

    match /issueStatusHistory/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge());
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if false;
    }

    match /issueAssignments/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if false;
    }

    match /issueAttachments/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || (isTeacherOrStaff() && (resource.data.uploadedBy == request.auth.uid || resource.data.issueId != null)));
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }


    match /propertyCategories/{id} {
      allow read: if isActive() && sameOrg(resource.data);
      allow write: if isSuper() || (isOrgAdmin() && sameOrg(request.resource.data));
    }

    match /madrasaAssets/{id} {
      allow read: if isActive() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create, update: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || (isTeacherOrStaff() && hasPermission('reportPropertyDamage')));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /assetTransactions/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge());
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if false;
    }

    match /assetMaintenance/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create, update: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge());
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /assetUnits/{id} {
      allow read: if isActive() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create, update: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge());
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /assetAttachments/{id} {
      allow read: if sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || isTeacherOrStaff());
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /userLifecycleHistory/{id} {
      allow read: if isSuper() || (isOrgAdmin() && sameOrg(resource.data)) || (ownUserData(resource.data) && hasPermission('viewLifecycleHistory'));
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageUserLifecycle'));
      allow update, delete: if false;
    }

    match /userServicePeriods/{id} {
      allow read: if isSuper() || (isOrgAdmin() && sameOrg(resource.data)) || (ownUserData(resource.data) && hasPermission('viewLifecycleHistory'));
      allow create, update: if sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageUserLifecycle'));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /lifecycleRecords/{id} {
      allow read: if isSuper() || (isOrgAdmin() && sameOrg(resource.data)) || (isCoordinator() && inAssignedMadrasaScope(resource.data)) || (isMadrasaIncharge() && inAssignedMadrasaScope(resource.data));
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageUserLifecycle'));
      allow update: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageUserLifecycle'));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /rejoinRequests/{id} {
      allow read: if isSuper() || (isOrgAdmin() && sameOrg(resource.data)) || (isCoordinator() && inAssignedMadrasaScope(resource.data)) || (isMadrasaIncharge() && inAssignedMadrasaScope(resource.data)) || (ownUserData(resource.data));
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageUserLifecycle'));
      allow delete: if isSuper() || (isOrgAdmin() && sameOrg(resource.data));
    }

    match /courseTypes/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageCourses'));
      allow delete: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageCourses'));
    }

    match /assets/{id} {
      allow read: if signedIn() && sameOrg(resource.data);
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || hasPermission('manageProperties'));
      allow update, delete: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || hasPermission('manageProperties'));
    }

    match /assetCategories/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && (isSuper() || isOrgAdmin() || hasPermission('manageProperties'));
    }

    match /assetTransactions/{id} {
      allow read: if signedIn() && sameOrg(resource.data);
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || hasPermission('manageProperties'));
      allow update, delete: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageProperties'));
    }

    match /assetAttachments/{id} {
      allow read: if signedIn() && sameOrg(resource.data);
      allow create: if signedIn() && sameOrg(request.resource.data);
      allow update, delete: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || hasPermission('manageProperties'));
    }

    match /assetMaintenance/{id} {
      allow read: if signedIn() && sameOrg(resource.data);
      allow create: if signedIn() && sameOrg(request.resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || hasPermission('manageProperties'));
      allow update, delete: if signedIn() && sameOrg(resource.data) && (isSuper() || isOrgAdmin() || isCoordinator() || isMadrasaIncharge() || hasPermission('manageProperties'));
    }

    match /firebaseUsageTelemetry/{id} {
      allow read: if isSuper() || hasPermission('viewFirebaseUsage');
      allow create, update: if signedIn() && isActive();
      allow delete: if isSuper();
    }

    match /{document=**} {
      allow read, write: if isSuper();
    }
  }
}
